# Exemple de configuration MySQL. Ne pas saisir de vrais secrets dans ce fichier.
# Définir ces variables dans l'environnement du serveur PHP.
# Ce projet ne charge pas automatiquement un fichier .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vite_gourmand
DB_USER=vite_gourmand_app
DB_PASSWORD=remplacer_par_un_secret_local
